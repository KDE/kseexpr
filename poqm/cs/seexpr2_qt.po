#: KSeExpr/ExprBuiltins.cpp:113
msgctxt "builtin|"
msgid ""
"float bias(float x, float g)\n"
"Variation of gamma where values less than 0.5 pull the curve down\n"
"and values greater than 0.5 pull the curve up\n"
"pow(x,log(b)/log(0.5))"
msgstr ""
"plovoucí bias(plovoucí x, plovoucí g)\n"
"Variace gama, přičemž hodnoty menší než 0,5 posouvají křivku dolů\n"
"a hodnoty větší než 0,5 posouvají křivku nahoru\n"
"pow(x,log(b)/log(0,5))"

#: KSeExpr/ExprBuiltins.cpp:124
msgctxt "builtin|"
msgid ""
"float contrast(float x, float c)\n"
"Adjust the contrast.&nbsp; For c from 0 to 0.5, the contrast is decreased."
"&nbsp; For c &gt; 0.5, the contrast is increased."
msgstr ""
"plovoucí kontrast(plovoucí x, plovoucí c)\n"
"Nastaví kontrast.&nbsp; Pro hodnotu c v rozmezí od 0 do 0,5 se kontrast "
"snižuje.&nbsp; Pro hodnotu c &gt; 0,5 se kontrast zvyšuje."

#: KSeExpr/ExprBuiltins.cpp:132
msgctxt "builtin|"
msgid ""
"float boxstep(float x,float a)\n"
" if x < a then 0 otherwise 1"
msgstr ""
"plovoucí boxstep(plovoucí x, plovoucí a)\n"
" pokud x < a, pak 0, jinak 1"

#: KSeExpr/ExprBuiltins.cpp:143
msgctxt "builtin|"
msgid ""
"float linearstep(float x, float a, float b)\n"
" if x &lt; a then 0, if x &gt; b then 1, and\n"
"x transitions linearly when a &lt; x &lt; b"
msgstr ""
"plovoucí lineární krok(plovoucí x, plovoucí a, plovoucí b)\n"
" pokud x &lt; a, pak 0; pokud x &gt; b, pak 1; a\n"
"x se lineárně mění, když a &lt; x &lt; b"

#: KSeExpr/ExprBuiltins.cpp:165
msgctxt "builtin|"
msgid ""
"float smoothstep(float x,float a,float b)\n"
" if x &lt; a then 0, if x &gt; b then 1, and\n"
"x transitions smoothly (cubic) when a &lt; x &lt; b"
msgstr ""
"plovoucí hladký krok(plovoucí x, plovoucí a, plovoucí b)\n"
" pokud x &lt; a, pak 0; pokud x &gt; b, pak 1; a\n"
"x přechází plynule (kubicky), když a &lt; x &lt; b"

#: KSeExpr/ExprBuiltins.cpp:187
msgctxt "builtin|"
msgid ""
"float gasussstep(float x,float a,float b)\n"
" if x &lt; a then 0, if x &gt; b then 1, and\n"
"x transitions smoothly (exponentially) when a &lt; x &lt; b"
msgstr ""
"plovoucí gaussovský krok(plovoucí x, plovoucí a, plovoucí b)\n"
" pokud x &lt; a, pak 0; pokud x &gt; b, pak 1; a\n"
"x přechází plynule (exponenciálně), když a &lt; x &lt; b"

#: KSeExpr/ExprBuiltins.cpp:218
msgctxt "builtin|"
msgid ""
"remap(float x, float source, float range, float falloff, float interp)\n"
"General remapping function.\n"
"When x is within +/- <i>range</i> of source, the result is one.\n"
"The result falls to zero beyond that range over <i>falloff</i> distance.\n"
"The falloff shape is controlled by <i>interp</i>. Numeric values\n"
"or named constants may be used:\n"
"&nbsp;&nbsp;&nbsp;&nbsp;int <b>linear</b> = 0\n"
"&nbsp;&nbsp;&nbsp;&nbsp;int <b>smooth</b> = 1\n"
"&nbsp;&nbsp;&nbsp;&nbsp;int <b>gaussian</b> = 2\n"
msgstr ""
"remap(plovoucí x, plovoucí zdroj, plovoucí rozsah, plovoucí pokles, plovoucí "
"interpolace)\n"
"Obecná funkce přemapování.\n"
"Pokud se x nachází v rozmezí +/- <i>rozsah</i> od zdroje, je výsledkem "
"jedna.\n"
"Mimo tento rozsah klesá výsledek na nulu v průběhu vzdálenosti <i>pokles</"
"i>.\n"
"Tvar poklesu je řízen parametrem <i>interp</i>. Lze použít číselné hodnoty\n"
"nebo pojmenované konstanty:\n"
"&nbsp;&nbsp;&nbsp;&nbsp;int <b>lineární</b> = 0\n"
"&nbsp;&nbsp;&nbsp;&nbsp;int <b>hladký</b> = 1\n"
"&nbsp;&nbsp;&nbsp;&nbsp;int <b>gaussovský</b> = 2\n"

#: KSeExpr/ExprBuiltins.cpp:233
msgctxt "builtin|"
msgid ""
"mix(float a,float b,float alpha)\n"
"Blend of a and b according to alpha."
msgstr ""
"mix(plovoucí a, plovoucí b, plovoucí alpha)\n"
"Smíchání hodnot a a b podle koeficientu alfa."

#: KSeExpr/ExprBuiltins.cpp:260
msgctxt "builtin|"
msgid ""
"color  hsi(color x, float h, float s, float i, float map=1)\n"
"The hsi function shifts the hue by h\n"
"(in degrees) and scales the saturation and intensity by s and i\n"
"respectively.&nbsp; A map may be supplied which will control the shift\n"
"- the full shift will happen when the map is one and no shift will\n"
"happen when the map is zero.&nbsp; The shift will be scaled back for\n"
"values between zero and one."
msgstr ""
"barevné  hsi(barevné x, plovoucí h, plovoucí s, plovoucí i, plovoucí map=1)\n"
"Funkce hsi posune odstín o hodnotu h\n"
"(ve stupních) a upraví sytost a jas o hodnoty s a i\n"
"v daném pořadí.&nbsp; Lze zadat mapu, která bude řídit posun\n"
"– k plnému posunu dojde, pokud je hodnota mapy rovna jedné, a k žádnému "
"posunu\n"
"nedojde, pokud je hodnota mapy rovna nule.&nbsp; Posun bude proporcionálně "
"zmenšen pro\n"
"hodnoty mezi nulou a jedničkou."

#: KSeExpr/ExprBuiltins.cpp:306
msgctxt "builtin|"
msgid ""
"color midhsi(color x, float h, float s, float i, float map, float falloff=1, "
"int interp=0)\n"
"The midhsi function is just like the hsi function except that\n"
"the control map is centered around the mid point (value of 0.5)\n"
"and can scale the shift in both directions."
msgstr ""
"barevné midhsi(barevné x, plovoucí h, plovoucí s, plovoucí i, plovoucí mapa, "
"plovoucí falloff=1, celé číslo interp=0)\n"
"Funkce midhsi je stejná jako funkce hsi, s tím rozdílem, že\n"
"řídicí mapa je vycentrována kolem středového bodu (hodnota 0,5)\n"
"a umožňuje měnit posun v obou směrech."

#: KSeExpr/ExprBuiltins.cpp:358
msgctxt "builtin|"
msgid ""
"color rgbtohsl(color rgb)\n"
"RGB to HSL color space conversion.\n"
"HSL is Hue, Saturation, Lightness (all in range [0..1] )\n"
"These functions have also been extended to support rgb and hsl values\n"
"outside of the range [0..1] in a reasonable way.&nbsp; For any rgb or\n"
"hsl value (except for negative s values), the conversion is\n"
"well-defined and reversible."
msgstr ""
"barevné rgbtohsl(barevné rgb)\n"
"Převod barevného prostoru RGB na HSL.\n"
"HSL znamená odstín (Hue), sytost (Saturation) a jas (Lightness) (vše v "
"rozsahu [0..1])\n"
"Tyto funkce byly také rozšířeny tak, aby rozumně podporovaly hodnoty rgb a "
"hsl\n"
"mimo rozsah [0..1].&nbsp; Pro jakoukoli hodnotu rgb nebo\n"
"hsl (s výjimkou záporných hodnot s) je převod\n"
"dobře definovaný a reverzibilní."

#: KSeExpr/ExprBuiltins.cpp:413
msgctxt "builtin|"
msgid ""
"color hsltorgb(color hsl)\n"
"HSL to RGB color space conversion.\n"
"HSL is Hue, Saturation, Lightness (all in range [0..1] )\n"
"These functions have also been extended to support rgb and hsl values\n"
"outside of the range [0..1] in a reasonable way.&nbsp; For any rgb or\n"
"hsl value (except for negative s values), the conversion is\n"
"well-defined and reversible."
msgstr ""
"barevné hsltorgb(barevné hsl)\n"
"Převod z barevného prostoru HSL do RGB.\n"
"HSL představuje odstín (Hue), sytost (Saturation) a jas (Lightness) (všechny "
"v rozsahu [0..1])\n"
"Tyto funkce byly také rozšířeny tak, aby rozumně podporovaly hodnoty rgb a "
"hsl\n"
"mimo rozsah [0..1].&nbsp; Pro jakoukoli hodnotu rgb nebo\n"
"hsl (s výjimkou záporných hodnot s) je převod\n"
"dobře definovaný a reverzibilní."

#: KSeExpr/ExprBuiltins.cpp:441
msgctxt "builtin|"
msgid ""
"color saturate(color val, float amt)\n"
"Scale saturation of color by amt.\n"
"The color is scaled around the rec709 luminance value,\n"
"and negative results are clamped at zero.\n"
msgstr ""
"barevná saturace(barevné val, plovoucí amt)\n"
"Upraví sytost barvy o hodnotu amt.\n"
"Barva se upravuje kolem hodnoty jasu podle standardu Rec.709,\n"
"a záporné výsledky se omezují na nulu.\n"

#: KSeExpr/ExprBuiltins.cpp:499
msgctxt "builtin|"
msgid ""
"float rand ( [float min, float max], [float seed] )\n"
"Random number between [min, max] (or [0, 1] if unspecified).\n"
"If a seed is supplied, it will be used in addition to the internal seeds and "
"may be used to create multiple distinct generators."
msgstr ""
"plovoucí rand ( [plovoucí min, plovoucí max], [plovoucí seed] )\n"
"Náhodné číslo v rozmezí [min, max] (nebo [0, 1], pokud není zadáno).\n"
"Je-li zadán počáteční bod, bude použit vedle interních počátečních bodů a "
"lze jej využít k vytvoření více různých generátorů."

#: KSeExpr/ExprBuiltins.cpp:553
msgctxt "builtin|"
msgid ""
"float hash(float seed1,[float seed2, ...])\n"
"Like rand, but with no internal seeds. Any number of seeds may be given\n"
"and the result will be a random function based on all the seeds."
msgstr ""
"plovoucí hash(plovoucí seed1,[plovoucí seed2, ...])\n"
"Podobně jako rand, avšak bez interních počátečních hodnot. Lze zadat "
"libovolný počet počátečních hodnot\n"
"a výsledkem bude náhodná funkce založená na všech zadaných počátečních "
"hodnotách."

#: KSeExpr/ExprBuiltins.cpp:596
msgctxt "builtin|"
msgid ""
"float noise ( vector v )\n"
"float noise ( float x, float y )\n"
"float noise ( float x, float y, float z )\n"
"float noise ( float x, float y, float z, float w )\n"
"Original perlin noise at location (C2 interpolant)"
msgstr ""
"plovoucí šum (vektor v)\n"
"plovoucí šum (plovoucí x, plovoucí y)\n"
"plovoucí šum (plovoucí x, plovoucí y, plovoucí z)\n"
"plovoucí šum (plovoucí x, plovoucí y, plovoucí z, plovoucí w)\n"
"Původní Perlinův šum v daném bodě (interpolant C2)"

#: KSeExpr/ExprBuiltins.cpp:610
msgctxt "builtin|"
msgid ""
"float snoise ( vector v)\n"
"signed noise w/ range -1 to 1 formed with original perlin noise at location "
"(C2 interpolant)"
msgstr ""
"plovoucí sšum (vektor v)\n"
"podepsaný šum v rozsahu od -1 do 1 vytvořený z původního Perlinova šumu v "
"bodě (interpolační bod C2)"

#: KSeExpr/ExprBuiltins.cpp:621
msgctxt "builtin|"
msgid ""
"vector vnoise ( vector v)\n"
"vector noise formed with original perlin noise at location (C2 interpolant)"
msgstr ""
"plovoucí všum (vektor v)\n"
"vektorový šum vytvořený z původního Perlinova šumu v bodě (interpolační bod "
"C2)"

#: KSeExpr/ExprBuiltins.cpp:629
msgctxt "builtin|"
msgid ""
"color cnoise ( vector v)\n"
"color noise formed with original perlin noise at location (C2 interpolant)"
msgstr ""
"barevný cšum (vektor v)\n"
"barevný šum vytvořený z původního Perlinova šumu v bodě (interpolační bod C2)"

#: KSeExpr/ExprBuiltins.cpp:640
msgctxt "builtin|"
msgid ""
"float snoise4 ( vector v,float t)\n"
"4D signed noise w/ range -1 to 1 formed with original perlin noise at "
"location (C2 interpolant)"
msgstr ""
"plovoucí sšum4 (vektor v, plovoucí t)\n"
"4D šum se znaménkem v rozsahu od -1 do 1, vytvořený z původního Perlinova "
"šumu v daném bodě (interpolační bod C2)"

#: KSeExpr/ExprBuiltins.cpp:651
msgctxt "builtin|"
msgid ""
"vector vnoise4 ( vector v,float t)\n"
"4D vector noise formed with original perlin noise at location (C2 "
"interpolant)"
msgstr ""
"vektorový všum4 (vektor v, float t)\n"
"4D vektorový šum vytvořený z původního Perlinova šumu v bodě (interpolační "
"bod C2)"

#: KSeExpr/ExprBuiltins.cpp:659
msgctxt "builtin|"
msgid ""
"color cnoise4 ( vector v,float t)\n"
"4D color noise formed with original perlin noise at location (C2 interpolant)"
msgstr ""
"barevný cšum4 (vektor v, číslo s plovoucí desetinnou čárkou t)\n"
"4D barevný šum vytvořený z původního Perlinova šumu v bodě (interpolační bod "
"C2)"

#: KSeExpr/ExprBuiltins.cpp:751
msgctxt "builtin|"
msgid ""
"float fbm(vector v,int octaves=6,float lacunarity=2,float gain=.5)\n"
"fbm (Fractal Brownian Motion) is a multi-frequency noise function. \n"
"The base frequency is the same as the \"noise\" function. The total number "
"of frequencies is controlled by octaves. The lacunarity is the spacing "
"between the frequencies - a value of 2 means each octave is twice the "
"previous frequency. The gain controls how much each frequency is scaled "
"relative to the previous frequency."
msgstr ""
"plovoucí fbm(vektor v, int oktávy=6, plovoucí lakunarita=2, plovoucí "
"zesílení=0,5)\n"
"fbm (Fractal Brownian Motion) je multifrekvenční šumová funkce. \n"
"Základní frekvence je stejná jako u funkce \"noise\". Celkový počet "
"frekvencí se řídí parametrem oktávy. Lakunarita udává rozestup mezi "
"frekvencemi – hodnota 2 znamená, že každá oktáva je dvojnásobkem předchozí "
"frekvence. Parametr zesílení určuje, o kolik se každá frekvence zvětší nebo "
"zmenší vzhledem k předchozí frekvenci."

#: KSeExpr/ExprBuiltins.cpp:787
msgctxt "builtin|"
msgid "vector vfbm(vector vint octaves=6,float lacunarity=2,float gain=.5)"
msgstr ""
"vektorový vfbm(vektor vint, oktávy=6, číslo s plovoucí desetinnou čárkou "
"lacunarity=2, číslo s plovoucí desetinnou čárkou zesílení=.5)"

#: KSeExpr/ExprBuiltins.cpp:820
msgctxt "builtin|"
msgid ""
"float fbm4(vector v,float time,int octaves=6,float lacunarity=2,float "
"gain=.5)\n"
"fbm (Fractal Brownian Motion) is a multi-frequency noise function. \n"
"The base frequency is the same as the \"noise\" function. The total \n"
"number of frequencies is controlled by octaves. The lacunarity is the \n"
"spacing between the frequencies - a value of 2 means each octave is \n"
"twice the previous frequency. The gain controls how much each \n"
"frequency is scaled relative to the previous frequency."
msgstr ""
"plovoucí fbm4(vektor v, plovoucí čas, int oktávy=6, plovoucí lakunarita=2, "
"plovoucí zesílení=0,5)\n"
"fbm (Fractal Brownian Motion) je multifrekvenční šumová funkce. \n"
"Základní frekvence je stejná jako u funkce \"noise\". Celkový \n"
"počet frekvencí se řídí parametrem oktávy. Lakunarita představuje \n"
"rozestup mezi frekvencemi – hodnota 2 znamená, že každá oktáva je \n"
"dvojnásobkem předchozí frekvence. Parametr zesílení určuje, o kolik se "
"každá \n"
"frekvence zvětší nebo zmenší vzhledem k předchozí frekvenci."

#: KSeExpr/ExprBuiltins.cpp:860
msgctxt "builtin|"
msgid ""
"vector vfbm4(vector v,float time,int octaves=6,float lacunarity=2,float "
"gain=.5)"
msgstr ""
"vektorový vfbm4(vektor v,plovoucí čas,int oktávy=6,plovoucí lakunarita=2,"
"plovoucí zesílení=0,5)"

#: KSeExpr/ExprBuiltins.cpp:866
msgctxt "builtin|"
msgid "color cfbm(vector vint octaves=6,float lacunarity=2,float gain=.5)"
msgstr ""
"barevné cfbm(vektorový vint oktávy=6, plovoucí lakunarita=2, plovoucí "
"zesílení=.5)"

#: KSeExpr/ExprBuiltins.cpp:872
msgctxt "builtin|"
msgid ""
"color cfbm4(vector v,float time,int octaves=6,float lacunarity=2,float "
"gain=.5)"
msgstr ""
"barevné cfbm4(vektor v,plovoucí čas,int oktávy=6,plovoucí lakunarita=2,"
"plovoucí zesílení=0,5)"

#: KSeExpr/ExprBuiltins.cpp:881
msgctxt "builtin|"
msgid ""
"float cellnoise(vector v)\n"
"cellnoise generates a field of constant colored cubes based on the integer "
"location.\n"
"This is the same as the prman cellnoise function."
msgstr ""
"plovoucí buněčný šum(vektor v)\n"
"Funkce buněčného šumu generuje pole kostky s konstantní barvou na základě "
"celočíselné polohy.\n"
"Jedná se o ekvivalent funkce buněčného šumu z knihovny prman."

#: KSeExpr/ExprBuiltins.cpp:893
msgctxt "builtin|"
msgid ""
"color cellnoise(vector v)\n"
"cellnoise generates a field of constant colored cubes based on the integer "
"location.\n"
"This is the same as the prman cellnoise function."
msgstr ""
"barevný buněčný šum(vektor v)\n"
"Funkce buněčného šumu generuje pole kostky konstantní barvy na základě "
"celočíselné polohy.\n"
"Jedná se o ekvivalent funkce buněčného šumu z knihovny prman."

#: KSeExpr/ExprBuiltins.cpp:906
msgctxt "builtin|"
msgid ""
"float pnoise ( vector v, vector period )\n"
"periodic noise"
msgstr ""
"plovoucí pšum (vektor v, vektorová perioda) \n"
"periodický šum"

#: KSeExpr/ExprBuiltins.cpp:1050
msgctxt "builtin|"
msgid ""
"float voronoi(vector v, int type=1,float jitter=0.5, float fbmScale=0, int "
"fbmOctaves=4,float fbmLacunarity=2, float fbmGain=.5)\n"
"voronoi is a cellular noise pattern. It is a jittered variant of cellnoise."
msgstr ""
"plovoucí voronoi(vektor v, int typ=1, plovoucí kolísání=0,5, plovoucí "
"fbmMěřítko=0, int fbmOktávy=4, plovoucí fbmLakunarita=2, plovoucí "
"fbmZesílení=0,5)\n"
"voronoi je buněčný šumový vzor. Jedná se o variantu buněčného šumu s "
"kolísáním."

#: KSeExpr/ExprBuiltins.cpp:1126
msgctxt "builtin|"
msgid ""
"color cvoronoi(vector v, int type=1,float jitter=0.5, float fbmScale=0, int "
"fbmOctaves=4,float fbmLacunarity=2, float fbmGain=.5)\n"
"returns color in cellular pattern. It is a jittered variant of cellnoise."
msgstr ""
"barevné cvoronoi(vektor v, int typ=1, plovoucí kolísání=0,5, float "
"fbmMěřítko=0, int fbmOktávy=4, plovoucí fbmLakunarita=2, float "
"fbmZesílení=0,5)\n"
"vrací barvu v buněčném vzoru. Jedná se o variantu funkce buněčného šumu s "
"kolísáním."

#: KSeExpr/ExprBuiltins.cpp:1175
msgctxt "builtin|"
msgid ""
"color pvoronoi(vector v, int type=1,float jitter=0.5, float fbmScale=0, int "
"fbmOctaves=4,float fbmLacunarity=2, float fbmGain=.5)\n"
"returns center of voronoi cell."
msgstr ""
"barevné pvoronoi(vektor v, int typ=1, plovoucí kolísání=0,5, plovoucí "
"fbmMěřítko=0, int fbmOktávy=4, plovoucí fbmLakunarita=2, plovoucí "
"fbmZesílení=0,5)\n"
"vrací střed voronoi buňky."

#: KSeExpr/ExprBuiltins.cpp:1238
msgctxt "builtin|"
msgid ""
"float dist(vector a, vector b)\n"
"distance between two points"
msgstr ""
"plovoucí dist(vektor a, vektor b)\n"
"vzdálenost mezi dvěma body"

#: KSeExpr/ExprBuiltins.cpp:1246
msgctxt "builtin|"
msgid ""
"float length(vector v)\n"
"length of vector"
msgstr ""
"float délka(vektor v)\n"
"délka vektoru"

#: KSeExpr/ExprBuiltins.cpp:1254
msgctxt "builtin|"
msgid ""
"float hypot(vector v)\n"
"length of 2d vector [x,y]"
msgstr ""
"plovoucí hypot(vektor v)\n"
"délka 2D vektoru [x, y]"

#: KSeExpr/ExprBuiltins.cpp:1262
msgctxt "builtin|"
msgid ""
"float dot(vector a,vector b)\n"
"vector dot product"
msgstr ""
"plovoucí dot(vektor a, vektor b)\n"
"vektorový skalární součin"

#: KSeExpr/ExprBuiltins.cpp:1274
msgctxt "builtin|"
msgid ""
"vector norm(vector v)\n"
"vector scaled to unit length"
msgstr ""
"vektorový norm(vektor v)\n"
"vektor zkrácený na jednotkovou délku"

#: KSeExpr/ExprBuiltins.cpp:1282
msgctxt "builtin|"
msgid ""
"vector cross(vector a,vector b)\n"
"vector cross product"
msgstr ""
"vektorový součin(vektor a, vektor b)\n"
"vektorový součin"

#: KSeExpr/ExprBuiltins.cpp:1293
msgctxt "builtin|"
msgid ""
"float angle(vector a,vector b)\n"
"angle between two vectors (in radians)"
msgstr ""
"plovoucí úhel(vektor a, vektor b)\n"
"úhel mezi dvěma vektory (v radiánech)"

#: KSeExpr/ExprBuiltins.cpp:1301
msgctxt "builtin|"
msgid ""
"vector angle(vector a,vector b)\n"
"normalized vector orthogonal to a and b scaled to unit length"
msgstr ""
"vektorový úhel(vektor a, vektor b)\n"
"normalizovaný vektor kolmý na vektory a a b, zkrácený na jednotkovou délku"

#: KSeExpr/ExprBuiltins.cpp:1317
msgctxt "builtin|"
msgid ""
"vector rotate(vector v,vector axis,float angle)\n"
"rotates v around axis by given angle (in radians)"
msgstr ""
"vektorová rotace(vektor v, vektor osy, plovoucí úhel)\n"
"otočí vektor v kolem osy o zadaný úhel (v radiánech)"

#: KSeExpr/ExprBuiltins.cpp:1327
msgctxt "builtin|"
msgid ""
"vector up(vector P,vector upvec)\n"
"rotates v such that the Y axis points in the given up direction"
msgstr ""
"vektor nahoru(vektor P, vektor upvec)\n"
"otočí v tak, aby osa Y směřovala daným směrem nahoru"

#: KSeExpr/ExprBuiltins.cpp:1343
msgctxt "builtin|"
msgid ""
"int cycle(int index, int loRange, int hiRange )\n"
"Cycles through values between loRange and hiRange based on supplied index.\n"
"This is an offset \"mod\" function. The result is computed as ``loRange + "
"value % (hiRange-loRange+1)``."
msgstr ""
"int cyklus(int index, int dolníRozsah, int horníRozsah) \n"
"Prochází hodnoty v rozmezí od dolníhoRozsahu do horníhoRozsahu na základě "
"zadaného indexu.\n"
"Jedná se o funkci \"mod\" s posunem. Výsledek se vypočítá jako ``dolníRozsah "
"+ hodnota % (horníRozsah - dolníRozsah + 1)``."

#: KSeExpr/ExprBuiltins.cpp:1405
msgctxt "builtin|"
msgid ""
"int pick(float index, int loRange, int hiRange, [float weights, ...] )\n"
"Picks values randomly between loRange and hiRange based on supplied index "
"(which is\n"
"automatically hashed).&nbsp; The values will be distributed according\n"
"to the supplied weights.&nbsp; Any weights not supplied are assumed to\n"
"be 1.0."
msgstr ""
"int pick(plovoucí index, int dolníRozsah, int horníRozsah, [plovoucí "
"váhy, ...] )\n"
"Náhodně vybírá hodnoty v rozmezí mezi dolnímRozsahem a hornímRozsahem na "
"základě zadaného indexu (který je\n"
"automaticky hašován)&nbsp; Hodnoty budou rozloženy podle\n"
"zadaných vah.&nbsp; U vah, které nebyly zadány, se předpokládá, že\n"
"mají hodnotu 1,0."

#: KSeExpr/ExprBuiltins.cpp:1416
msgctxt "builtin|"
msgid ""
"color swatch(float index, color choice0, color choice1, color choice2, "
"[...])\n"
"Chooses one of the supplied color choices based on the index (assumed to be "
"in range [0..1])."
msgstr ""
"barevný vzorek(plovoucí index, barevná volba0, barevná volba1, barevná "
"volba2, [...])\n"
"Vybere jednu z předložených barevných voleb na základě indexu (předpokládá "
"se, že je v rozmezí [0..1])."

#: KSeExpr/ExprBuiltins.cpp:1431
msgctxt "builtin|"
msgid ""
"float choose(float index,float choice1, float choice2, [...])\n"
"Chooses one of the supplied choices based on the index (assumed to be in "
"range [0, 1])."
msgstr ""
"plovoucí výběr(plovoucí index, plovoucí volba1, plovoucí volba2, [...])\n"
"Vybere jednu z předložených voleb na základě indexu (předpokládá se, že leží "
"v rozmezí [0, 1])."

#: KSeExpr/ExprBuiltins.cpp:1487
msgctxt "builtin|"
msgid ""
"float wchoose(float index,float choice1, float weight1, float choice2, float "
"weight2, [...] )\n"
"Chooses one of the supplied choices based on the index (assumed to be in "
"range [0..1]).\n"
"The values will be distributed according to the supplied weights."
msgstr ""
"plovoucí wvýběr(plovoucí index, plovoucí volba1, plovoucí váha1, plovoucí "
"volba2, plovoucí váha2, [...])\n"
"Vybere jednu z předložených voleb na základě indexu (předpokládá se, že leží "
"v rozmezí [0..1]).\n"
"Hodnoty budou rozděleny podle zadaných vah."

#: KSeExpr/ExprBuiltins.cpp:1509
msgctxt "builtin|"
msgid ""
"float spline(float param,float y1,float y2,float y3,float y4,[...])\n"
"\n"
"Interpolates a set of values to the parameter specified where y1, ..., yn "
"are\n"
"distributed evenly from [0..1]"
msgstr ""
"plovoucí křivka(plovoucí parametr, plovoucí y1, plovoucí y2, plovoucí y3, "
"plovoucí y4, [...])\n"
"\n"
"Provádí interpolaci sady hodnot podle zadaného parametru, přičemž y1, ..., "
"yn jsou\n"
"rovnoměrně rozloženy v intervalu [0..1]"

#: KSeExpr/ExprBuiltins.cpp:1550 KSeExpr/ExprBuiltins.cpp:1615
msgctxt "builtin|"
msgid "Unable to validate the interpolant type"
msgstr "Nelze ověřit typ interpolačního prvku"

#: KSeExpr/ExprBuiltins.cpp:1554 KSeExpr/ExprBuiltins.cpp:1618
msgctxt "builtin|"
msgid "Invalid interpolant type"
msgstr "Neplatný typ interpolačního prvku"

#: KSeExpr/ExprBuiltins.cpp:1588
msgctxt "builtin|"
msgid ""
"float curve(float param,float pos0,float val0,int interp0,float pos1,float "
"val1,int interp1,[...])\n"
"\n"
"Interpolates a 1D ramp defined by control points at 'param'. Control points "
"are specified \n"
"by triples of parameters pos_i, val_i, and interp_i. Interpolation codes "
"are \n"
"0 - none, 1 - linear, 2 - smooth, 3 - spline, \n"
"4 - monotone (non oscillating spline)"
msgstr ""
"plovoucí křivka(plovoucí parametr, plovoucí pos0, plovoucí val0, int "
"interp0, plovoucí pos1, plovoucí val1, int interp1, [...])\n"
"\n"
"Interpoluje jednorozměrnou rampu definovanou kontrolními body v "
"'paramentru'. Kontrolní body jsou specifikovány \n"
"trojicemi parametrů pos_i, val_i a interp_i. Kódy interpolace jsou \n"
"0 – žádná, 1 – lineární, 2 – vyhlazená, 3 – křivka, \n"
"4 – monotónní (neoscilující křivka)"

#: KSeExpr/ExprBuiltins.cpp:1660
msgctxt "builtin|"
msgid ""
"color curve(float param,float pos0,color val0,int interp0,float pos1,color "
"val1,int interp1,[...])\n"
"\n"
"Interpolates color ramp given by control points at 'param'. Control points "
"are specified \n"
"by triples of parameters pos_i, val_i, and interp_i. Interpolation codes "
"are \n"
"0 - none, 1 - linear, 2 - smooth, 3 - spline, \n"
"4 - monotone (non oscillating spline)"
msgstr ""
"barevná křivka(plovoucí parametr, plovoucí pos0, barevná val0, int interp0, "
"plovoucí pos1, barevná val1, int interp1, [...])\n"
"\n"
"Interpoluje barevnou rampu danou kontrolními body v 'parametru'. Kontrolní "
"body jsou specifikovány \n"
"trojicemi parametrů pos_i, val_i a interp_i. Kódy interpolace jsou \n"
"0 – žádná, 1 – lineární, 2 – vyhlazená, 3 – křivka, \n"
"4 – monotónní (neoscilující křivka)"

#: KSeExpr/ExprBuiltins.cpp:1732
msgctxt "builtin|"
msgid ""
"getVar(string varName,vector defaultValue)\n"
"return value of varName if variable exists, otherwise return defaultValue"
msgstr ""
"getVar(string varNázev, vektor výchozíHodnota)\n"
"vrátí hodnotu proměnné varNázev, pokud proměnná existuje; v opačném případě "
"vrátí hodnotu výchozíHodnota"

#: KSeExpr/ExprBuiltins.cpp:1879
msgctxt "builtin|"
msgid ""
"float printf(string format,[vec0, vec1,  ...])\n"
"Prints out a string to STDOUT, Format parameters allowed are \"%v\" and \"%f"
"\".\n"
"Return parameter is empty, but must be assigned to a variable."
msgstr ""
"plovoucí printf(formát řetězce, [vec0, vec1,  ...])\n"
"Vypíše řetězec na STDOUT. Povolené parametry formátu jsou \"%v\" a \"%f\".\n"
"Návratová hodnota je prázdná, musí však být přiřazena proměnné."

#: KSeExpr/ExprBuiltins.cpp:1992
msgctxt "builtin|"
msgid ""
"sprintf(string format, [double|string, double|string, ...])\n"
"Returns a string formatted from the given values.  See 'man sprintf' for "
"format details."
msgstr ""
"sprintf(formát řetězce, [dvojité|řetězec, dvojité|řetězec, ...])\n"
"Vrací řetězec naformátovaný podle zadaných hodnot. Podrobnosti o formátu "
